# Feature-representation experiment — environment contract.
# Copy to `.env` (repo root, or wherever you run `assert-ai`) and paste the
# real keys ON THE WORK LAPTOP ONLY. Never commit `.env`. Rotate any key that
# has been shared in chat. The repo loads this via python-dotenv.
#
# TWO REALITIES THAT DRIVE THIS ROUTING:
#   1. Point every azure/<name> model string at one deployment you control.
#   2. A guardrail/attack eval MUST run on an UNFILTERED deployment, or the
#      platform content filter blocks attack prompts and security transcripts
#      -> the agent "refuses" because of the FILTER (not its behavior) and the
#      judge drops cases. So one unfiltered resource is primary for EVERYTHING:
#      eval pipeline, judge, AND the agent under test.

# ---- PRIMARY: eval pipeline + judge + agent (all on one unfiltered resource) -
# Use an UNFILTERED Azure OpenAI resource. LiteLLM resolves `azure/<deployment>`
# via AZURE_API_KEY/AZURE_API_BASE. The bank agent (SUT) reads the same resource
# via AGENT_MODEL below.
AZURE_API_KEY=<paste-your-azure-openai-key>
AZURE_API_BASE=https://<your-azure-openai-resource>.openai.azure.com/
AZURE_API_VERSION=2024-12-01-preview
# Deployment name on your resource. MUST match the azure/<name> model strings
# in the eval_realistic_*.yaml configs (currently azure/gpt-5.4-mini). If your
# deployment is named differently, change BOTH here and in the YAMLs so the
# agent-under-test and the eval/judge use the same unfiltered deployment.
AGENT_MODEL=gpt-5.4-mini

# ---- FILTERED secondary (do NOT use for attack/judge work) -----------------
# A FILTERED deployment is only safe for benign-only spot checks. NOT a valid
# cross-judge here (the filter blocks the adversarial cells).
AZURE_API_KEY_FILTERED=<paste-your-filtered-key>
AZURE_API_BASE_FILTERED=https://<your-filtered-resource>.openai.azure.com/

# ---- Contamination guard ----------------------------------------------------
# A true cross-judge needs a DIFFERENT *unfiltered* model, which doesn't exist
# yet. So the PRIMARY guard is the human-audit subset (~50 stratified cases).
# Deploy one different-family unfiltered judge (e.g. gpt-4.1) later to add the
# model-disagreement leg.

# ---- Knowledge base backend ------------------------------------------------
# mock = local BM25 over knowledge/*.md (no Azure; use for P0-P4).
# foundry = real Foundry IQ (P5, after the KB is built).
KB_BACKEND=mock
KB_CORPUS_DIR=examples/bank_manager_agent_control/knowledge

# ---- Foundry IQ (P5 only) --------------------------------------------------
# Your Azure OpenAI resource is used here only for KB embedding +
# answer-synthesis over benign policy docs (content filter is fine for that).
AOAI_API_KEY=<paste-aoai-key>
AOAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
FOUNDRY_ENDPOINT=https://<your-aoai-resource>.services.ai.azure.com/api/projects/<your-project>
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
SEARCH_API_KEY=<paste-search-admin-key>
PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<your-rg>/providers/Microsoft.CognitiveServices/accounts/<your-aoai-resource>/projects/<your-project>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_SEARCH_KB_NAME=bank-policy-kb
FOUNDRY_IQ_API_VERSION=2026-05-01-preview
